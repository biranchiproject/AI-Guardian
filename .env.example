# AI Guardian Environment Variables Template
# Copy this file to .env and fill in your actual keys.

# GROQ API Key (Required for AI Analysis and Chatbot)
# Get yours here: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Google Safe Browsing API Key (Optional)
# GOOGLE_SAFE_API_KEY=your_google_api_key_here

# Port for the Flask backend
PORT=5000
