<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0B0F19">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI GUARDIAN"
        android:textColor="#EF4444"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Real-time Mobile Security"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <Switch
        android:id="@+id/switchGuard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Omni-Channel Protection"
        android:textColor="#E5E7EB"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:trackTint="#334155"
        android:thumbTint="#EF4444" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: INACTIVE"
        android:textColor="#EF4444"
        android:textAlignment="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="ENABLE NOTIFICATION SCANNER"
        android:backgroundTint="#EF4444"
        android:textColor="#FFFFFF" />

</LinearLayout>
